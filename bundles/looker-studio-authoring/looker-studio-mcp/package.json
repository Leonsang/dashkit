{
  "name": "looker-studio-mcp",
  "version": "0.2.0",
  "description": "MCP server que controla un informe de Looker Studio abierto en Chrome/Edge via CDP (puppeteer-core).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "looker-studio-mcp": "dist/index.js",
    "ls-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "examples",
    "README.md",
    "themes"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node tools/esbuild.mjs",
    "dev": "tsc --noEmit --watch",
    "check": "node tools/check-page-scripts.mjs && node tools/mcp-smoke.mjs && node tools/ops-reference.mjs --check",
    "start": "node dist/index.js",
    "bundle": "node tools/build-bundle.mjs",
    "cli": "node dist/cli.js",
    "build:mcpb": "node tools/build-mcpb.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "puppeteer-core": "^25.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint-scope": "^9.1.2",
    "javascript-obfuscator": "^5.10.0",
    "typescript": "^7.0.2"
  }
}
