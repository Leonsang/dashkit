  "bundles": [
    {
      "id": "powerbi-authoring",
      "kind": "vendored",
      "title": "Power BI authoring",
      "description": "Developer skills for authoring Microsoft Power BI solutions.",
      "dir": "plugins/powerbi-authoring",
      "skills": [
        "semantic-model-authoring",
        "powerbi-report-planning",
        "powerbi-report-design",
        "powerbi-report-authoring",
        "powerbi-report-management"
      ],
      "agents": [],
      "common": [
        "COMMON-CLI.md",
        "COMMON-CORE.md",
        "ITEM-DEFINITIONS-CORE.md"
      ],
      "mcpServers": {
        "powerbi-modeling-mcp": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@microsoft/powerbi-modeling-mcp@latest",
            "--start"
          ]
        }
      },
      "prereqs": {
        "required": [
          "git",
          "node20",
          "npm:@microsoft/powerbi-report-authoring-cli"
        ],
        "optional": [
          "npm:@microsoft/powerbi-desktop-bridge-cli",
          "pbir-cli",
          "az",
          "powerbi-desktop"
        ]
      },
      "credit": {
        "author": "Microsoft",
        "license": "MIT",
        "homepage": "https://github.com/microsoft/skills-for-fabric"
      }
    },
    {
      "id": "fabric-skills",
      "kind": "vendored",
      "title": "Fabric — everything",
      "description": "Complete bundle: all Microsoft Skills for Fabric for developers and consumers",
      "dir": "plugins/fabric-skills",
      "skills": [
        "fabriciq",
        "semantic-model-authoring",
        "spark-cli",
        "sqldw-cli",
        "eventhouse-cli",
