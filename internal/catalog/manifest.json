      "skills": [
        "pbi-sdd"
      ],
      "prereqs": {
        "required": [
          "node20"
        ],
        "optional": []
      },
      "credit": {
        "author": "dashkit",
        "license": "MIT",
        "homepage": "https://github.com/leonsang/dashkit"
      }
    },
    {
      "id": "tableau-authoring",
      "kind": "builtin",
      "title": "Tableau authoring",
      "description": "Drives Tableau Desktop 2026.3 through its External Client API with the tableu MCP server: data sources and .hyper extracts, fields, calculations, parameters, sets, sheets, filters, formatting, dashboards, navigation buttons, filter/parameter/set actions and stories, each validated by Tableau and linted against its best practices. Includes a tableau-author subagent and /setup.",
      "dir": "tableau-authoring",
      "skills": [
        "tableau-authoring",
        "tableau-data-model",
        "tableau-design"
      ],
      "agents": [
        "tableau-author.md"
      ],
      "files": [
        "server"
      ],
      "mcpServers": {
        "tableu": {
          "command": "uv",
          "args": [
            "--directory",
            "${DASHKIT_BUNDLE}/server",
            "run",
            "--quiet",
            "tableu-mcp"
          ]
        }
      },
      "prereqs": {
        "required": [
          "uv",
          "tableau-desktop"
        ],
        "optional": [
          "tableau-api-flag"
        ]
      },
      "marketplace": {
        "repo": "leonsang/dashkit",
        "name": "dashkit",
        "plugin": "tableau-authoring"
      },
      "credit": {
        "author": "dashkit",
        "license": "MIT",
        "homepage": "https://github.com/leonsang/dashkit"
      }
    },
