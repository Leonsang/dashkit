      "mcpServers": {
        "looker-studio": {
          "command": "node",
          "args": [
            "${DASHKIT_BUNDLE}/looker-studio-mcp/dist/index.js"
          ],
          "env": {
            "LS_ALLOW_WRITE": "1",
            "LS_SKILLS_DIR": "${DASHKIT_BUNDLE}/skills"
          }
        }
      },
      "prereqs": {
        "required": [
          "node20"
        ],
        "optional": [
          "cdp-9222"
        ]
