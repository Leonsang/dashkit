    {
      "id": "pbi-sdd",
      "kind": "builtin",
      "title": "Spec-driven workflow",
      "description": "A thin spec-driven workflow for Power BI: survey an existing or published report (levantamiento), or start a new one, then spec, tasks, build and verify with written, approved steps. Leans on the Microsoft and data-goblin skills rather than repeating them.",
